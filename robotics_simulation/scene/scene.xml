<mujoco model="go2w scene">
  <compiler assetdir="assets/models/"/>
  <include file="go2w.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <visual>
        <!-- This forces MuJoCo's offline/headless cameras to use light calculations -->
        <headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
        <global offwidth="640" offheight="480"/>
    </visual>
  <asset>

    <!-- Main ground --> 
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Rock Brown -->
    <texture name="rock_brown_tex" type="2d" file="rock_brown/rock_brown.png"/>
    <material name="rock_brown_mat" texture="rock_brown_tex" roughness="0.8"/>
    <mesh name="rock_brown_mesh" file="../assets/models/rock_brown/rock_brown.obj"/>

    <!-- Truck Dumper -->
    <texture name="truck_dumper_tex" type="2d" file="truck_dumper/truck_dumper.png"/>
    <material name="truck_dumper_mat" texture="truck_dumper_tex" roughness="0.5"/>
    <mesh name="truck_dumper_mesh" file="../assets/models/truck_dumper/truck_dumper.obj"/>

    <!-- Ground Rocks Flat -->
    <texture name="ground_rocks_flat_tex" type="2d" file="ground_rocks/ground_rocks.png"/>
    <material name="ground_rocks_flat_mat" texture="ground_rocks_flat_tex" roughness="0.5"/>
    <mesh name="ground_rocks_flat_mesh" file="../assets/models/ground_rocks/ground_rocks.obj" scale="1 0.125 1"/>

    <!-- Ground Rocks high -->
    <texture name="ground_rocks_high_tex" type="2d" file="ground_rocks/ground_rocks.png"/>
    <material name="ground_rocks_high_mat" texture="ground_rocks_high_tex" roughness="0.5"/>
    <mesh name="ground_rocks_high_mesh" file="../assets/models/ground_rocks/ground_rocks.obj"/>

    <!-- Cone Warning -->
    <texture name="cone_warning_tex" type="2d" file="cone_warning/cone_warning.png"/>
    <material name="cone_warning_mat" texture="cone_warning_tex" roughness="0.5"/>
    <mesh name="cone_warning_mesh" file="../assets/models/cone_warning/cone_warning.obj" scale="0.027 0.027 0.027"/>

  </asset>
  <worldbody>
    <!-- Floor -->
    <geom name="floor_base" type="plane" pos="0 0 0" size="0 0 1"/>

  <!-- Ground Rocks Flat -->
    <body name="ground_rocks_flat_1" pos="-10 0 0.03">
        <body name="ground_rocks_flat_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="ground_rocks_flat_mesh" material="ground_rocks_flat_mat" contype="0" conaffinity="0" group="1"/>
        </body>
    </body>

    <!-- Rock Brown -->
    <body name="rock_brown_light" pos="-4 0 0.2">
      <geom name="collision" group="3" type="cylinder" size="0.6 0.5" pos="7.2 -0.2 0.1" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
      <body name="rock_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
        <geom type="mesh" mesh="rock_brown_mesh" material="rock_brown_mat" contype="0" conaffinity="0" group="2"/>
      </body>
    </body>

    <!-- Truck Dumper -->
    <body name="truck_dumper" pos="-29 29 -0.4">
        <!-- <geom name="wheel_right_up_collision" type="box" size="0.6 0.3 0.3" pos="0 0 0" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>-->
        <!-- <geom name="wheel_right_down_collision" type="box" size="0.6 0.3 0.3" pos="0 0 0" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>-->
        <!-- <geom name="wheel_left_up_collision" type="box" size="0.6 0.3 0.3" pos="0 0 0" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>-->
        <!-- <geom name="wheel_left_down_collision" type="box" size="0.6 0.3 0.3" pos="0 0 0" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>-->
        <!-- <geom name="wheel_ladder_front_right_collision" type="box" size="0.6 0.3 0.3" pos="0 0 0" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>-->
        <!-- <geom name="wheel_ladder_front_left_collision" type="box" size="0.6 0.3 0.3" pos="0 0 0" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>-->
        <body name="truck_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="truck_dumper_mesh" material="truck_dumper_mat" contype="0" conaffinity="0" group="1"/>
        </body>
    </body>

    <!-- Ground Rocks High -->
    <body name="ground_rocks_high_1" pos="-19 0 0.03">
        <body name="ground_rocks_high_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="ground_rocks_high_mesh" material="ground_rocks_high_mat" contype="0" conaffinity="0" group="1"/>
        </body>
        <body name="ground_rocks_high_collision_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="ground_rocks_high_mesh" contype="1" conaffinity="1"/>
        </body>
    </body>

    <!-- Cone Warning -->
    <body name="cone_warning" pos="-1 0 0.03">
        <geom name="cone_collision" group="3" type="capsule" size="0.15 0.3" pos="0 0 0.15" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" solref="0.002 1" solimp="0.999 0.999 0.001"/>        <body name="cone_warning_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="cone_warning_mesh" material="cone_warning_mat" contype="0" conaffinity="0" group="1"/>
        </body>
    </body>

  </worldbody>
</mujoco>