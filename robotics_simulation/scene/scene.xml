<mujoco model="go2w scene">
  <compiler assetdir="assets/models/"/>
  <include file="go2w.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <visual>
        <!-- This forces MuJoCo's offline/headless cameras to use light calculations -->
        <headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
        <global offwidth="640" offheight="480"/>
    </visual>
  <asset>

    <!-- Main ground --> 
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Truck Dumper -->
    <texture name="truck_dumper_tex" type="2d" file="truck_dumper/truck_dumper.png"/>
    <material name="truck_dumper_mat" texture="truck_dumper_tex" roughness="0.5"/>
    <mesh name="truck_dumper_mesh" file="../assets/models/truck_dumper/truck_dumper.obj"/>

  </asset>
  <worldbody>
    <!-- Floor -->
    <geom name="floor_base" type="plane" pos="0 0 0" size="0 0 1"/>

    <!-- Truck Dumper -->
    <body name="truck_dumper" pos="-29 29 -0.4">
        <body name="truck_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="truck_dumper_mesh" material="truck_dumper_mat" contype="0" conaffinity="0" group="1"/>
        </body>
        <body name="truck_collision_primitives" pos="0 0 0">
            <geom name="wheel_back_right" type="cylinder" size="1.5 1.47" pos="24.65 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4"/>
            <geom name="wheel_back_left" type="cylinder" size="1.5 1.47" pos="19.05 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4"/>
        </body>
    </body>




  </worldbody>
</mujoco>