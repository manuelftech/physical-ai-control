<mujoco model="go2w scene">
  <compiler assetdir="assets/models/"/>
  <include file="go2w.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <visual>
        <!-- This forces MuJoCo's offline/headless cameras to use light calculations -->
        <headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
        <global offwidth="640" offheight="480"/>
    </visual>


  <asset>

<!-- Main ground --> 
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

<!-- Rock Brown Light -->
    <texture name="rock_brown_light_tex" type="2d" file="rock_brown_light/rock_brown_light.png"/>
    <material name="rock_brown_light_mat" texture="rock_brown_light_tex" roughness="0.8"/>
    <mesh name="rock_brown_light_mesh" file="../assets/models/rock_brown_light/rock_brown_light.obj"/>

<!-- Truck Dumper -->
    <texture name="truck_dumper_tex" type="2d" file="truck_dumper/truck_dumper.png"/>
    <material name="truck_dumper_mat" texture="truck_dumper_tex" roughness="0.5"/>
    <mesh name="truck_dumper_mesh" file="../assets/models/truck_dumper/truck_dumper.obj"/>

<!-- Ground Rocks -->
    <texture name="ground_rocks_tex" type="2d" file="ground_rocks/ground_rocks.png"/>
    <material name="ground_rocks_mat" texture="ground_rocks_tex" roughness="0.5"/>
    <mesh name="ground_rocks_mesh" file="../assets/models/ground_rocks/ground_rocks.obj" scale="1 0.125 1"/>

<!-- Rock Low Height -->
    <texture name="rock_low_height_tex" type="2d" file="rock_low_height/rock_low_height.png"/>
    <material name="rock_low_height_mat" texture="rock_low_height_tex" roughness="0.5"/>
    <mesh name="rock_low_height_mesh" file="../assets/models/rock_low_height/rock_low_height.obj" scale="0.3 0.3 0.3"/>

  </asset>
  <worldbody>
    <!-- Floor -->
    <geom name="floor_base" type="plane" pos="0 0 0" size="0 0 1"/>

     <!-- Rock Brown Light -->
    <body name="rock_brown_light" pos="-4 0 0.2">
      <geom name="collision" group="3" type="cylinder" size="0.6 0.5" pos="7.2 -0.2 0.1" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
      <body name="rock_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
        <geom type="mesh" mesh="rock_brown_light_mesh" material="rock_brown_light_mat" contype="0" conaffinity="0" group="2"/>
      </body>
    </body>

    <!-- Truck Dumper -->
    <body name="truck_dumper" pos="-5 0 0.2">
        <!-- <geom name="wheel_right_up_collision" type="box" size="0.6 0.3 0.3" pos="0 0 0" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>-->
        <body name="truck_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="truck_dumper_mesh" material="truck_dumper_mat" contype="0" conaffinity="0" group="1"/>
        </body>
    </body>

    <!-- Ground Rocks -->
    <body name="ground_rocks" pos="-10 0 0.03">
        <!--<geom name="ground_rocks_collision" type="box" size="0.6 0.3 0.3" pos="-5 0 0" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>-->
        <body name="ground_rocks_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="ground_rocks_mesh" material="ground_rocks_mat" contype="0" conaffinity="0" group="1"/>
        </body>
    </body>

  </worldbody>
</mujoco>