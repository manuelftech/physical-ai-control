<mujoco model="go2w scene">
  <compiler assetdir="assets/models/"/>
  <include file="go2w.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <visual>
        <!-- This forces MuJoCo's offline/headless cameras to use light calculations -->
        <headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
        <global offwidth="1280" offheight="720"/>
    </visual>
  <asset>

  <!-- Main ground --> 
  <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
  <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.67 0.60 0.54" rgb2="0.60 0.53 0.47" markrgb="0.8 0.8 0.8" width="300" height="300"/>
  <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1" roughness="0.6"/>

  <!-- Truck Dumper -->
  <texture name="truck_dumper_tex" type="2d" file="truck_dumper/truck_dumper.png"/>
  <material name="truck_dumper_mat" texture="truck_dumper_tex" roughness="0.5"/>
  <mesh name="truck_dumper_mesh" file="../assets/models/truck_dumper/truck_dumper.obj"/>

  <!-- Big Rock -->
  <texture name="big_rock_tex" type="2d" file="big_rock/big_rock.png"/>
  <material name="big_rock_mat" texture="big_rock_tex" roughness="0.8"/>
  <mesh name="big_rock_mesh" file="../assets/models/big_rock/big_rock.obj"/>

  <!-- Flat Terrain covering the complete scene -->
  <texture name="flat_terrain_scene_tex" type="2d" file="flat_terrain_scene/flat_terrain_scene.png"/>
  <material name="flat_terrain_scene_mat" texture="flat_terrain_scene_tex" roughness="0.5"/>
  <mesh name="flat_terrain_scene_mesh" file="../assets/models/flat_terrain_scene/flat_terrain_scene.obj" scale="100 0.001 100" inertia="shell"/>

  <!-- Flat Terrain higher detail -->
  <texture name="flat_terrain_tex" type="2d" file="flat_terrain/flat_terrain.png"/>
  <material name="flat_terrain_mat" texture="flat_terrain_tex" roughness="0.5"/>
  <mesh name="flat_terrain_mesh" file="../assets/models/flat_terrain/flat_terrain.obj" scale="5 0.001 5" inertia="shell"/>

  <!-- Ground Rocks - Flat -->
  <mesh name="ground_rocks_flat_mesh" file="../assets/models/ground_rocks/ground_rocks.obj" scale="1 0.125 1"/>

  <!-- Ground Rocks - Big -->
  <mesh name="ground_rocks_flat_big_mesh" file="../assets/models/ground_rocks/ground_rocks.obj" scale="4 0.125 4"/>

  <!-- Ground Rocks -->
  <texture name="ground_rocks_tex" type="2d" file="ground_rocks/ground_rocks.png"/>
  <material name="ground_rocks_mat" texture="ground_rocks_tex" roughness="0.5"/>
  <mesh name="ground_rocks_mesh" file="../assets/models/ground_rocks/ground_rocks.obj"/>
  
  <!-- Mountain -->
  <texture name="mountain_tex" type="2d" file="mountain/mountain.png"/>
  <material name="mountain_mat" texture="mountain_tex" roughness="0.5"/>
  <mesh name="mountain_mesh" file="../assets/models/mountain/mountain.obj" scale="0.05 0.05 0.05"/>

  <!-- Board Square -->
  <texture name="board_square_tex" type="2d" file="board_square/board_square.png"/>
  <material name="board_square_mat" texture="board_square_tex" roughness="0.5"/>
  <mesh name="board_square_mesh" file="../assets/models/board_square/board_square.obj" scale="0.008 0.008 0.008"/>

  </asset>
  <worldbody>
    <!-- Base Floor -->
    <geom name="floor_base" type="plane" pos="0 0 0" size="0 0 1" material="groundplane"/>

    <!-- Truck Dumper 1 -->
    <body name="truck_dumper_1" pos="55 24 -0.4" euler="0 0 4.71">
        <body name="truck_visual_sub_1" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="truck_dumper_mesh" material="truck_dumper_mat" contype="0" conaffinity="0" group="1"/>
        </body>
        <body name="collisions_truck_wheels_1" pos="0 0 0">
            <geom name="wheel_front_right_1" type="cylinder" size="1.5 0.65" pos="18.35 -42 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_front_left_1" type="cylinder" size="1.5 0.65" pos="25.5 -42 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_back_right_1" type="cylinder" size="1.5 1.47" pos="24.65 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_back_left_1" type="cylinder" size="1.5 1.47" pos="19.15 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/></body>
        <body name="collisions_truck_ladders_1" pos="0 0 0">
            <geom name="ladder_left_1" type="box" size="0.05 0.25 0.7" pos="24.325 -45.5 1.4" quat="-0.75 0 0.1 0.001" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="ladder_right_1" type="box" size="0.2 0.05 0.65" pos="20.225 -45.83 1.4" quat="0 0 0.5 -0.07" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
        </body>
    </body>

    <!-- Truck Dumper 2 -->
    <body name="truck_dumper_2" pos="55 50 -0.4" euler="0 0 4.71">
        <body name="truck_visual_sub_2" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="truck_dumper_mesh" material="truck_dumper_mat" contype="0" conaffinity="0" group="1"/>
        </body>
        <body name="collisions_truck_wheels_2" pos="0 0 0">
            <geom name="wheel_front_right_2" type="cylinder" size="1.5 0.65" pos="18.35 -42 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_front_left_2" type="cylinder" size="1.5 0.65" pos="25.5 -42 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_back_right_2" type="cylinder" size="1.5 1.47" pos="24.65 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_back_left_2" type="cylinder" size="1.5 1.47" pos="19.15 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/></body>
        <body name="collisions_truck_ladders_2" pos="0 0 0">
            <geom name="ladder_left_2" type="box" size="0.05 0.25 0.7" pos="24.325 -45.5 1.4" quat="-0.75 0 0.1 0.001" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="ladder_right_2" type="box" size="0.2 0.05 0.65" pos="20.225 -45.83 1.4" quat="0 0 0.5 -0.07" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
        </body>
    </body>

    <!-- Big Rock under Truck 1 -->
    <body name="big_rock_1" pos="8 2 0.2">
      <geom name="big_rock_1_collision" group="3" type="cylinder" size="0.6 0.5" pos="7.2 -0.2 0.1" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
      <body name="big_rock_1_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
        <geom type="mesh" mesh="big_rock_mesh" material="big_rock_mat" contype="0" conaffinity="0" group="2"/>
      </body>
    </body>

    <!-- Big Rock under Truck 2 -->
    <body name="big_rock_2" pos="4 23 0.2"> 
      <geom name="big_rock_2_collision" group="3" type="cylinder" size="0.6 0.5" pos="7.2 -0.2 0.1" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
      <body name="big_rock_2_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
        <geom type="mesh" mesh="big_rock_mesh" material="big_rock_mat" contype="0" conaffinity="0" group="2"/>
      </body>
    </body>

    <!-- Mountain -->
    <body name="mountain" pos="0 0 0">
    <geom name="mountain_collision_right" group="3" type="cylinder" size="150 20" pos="180 -0.2 0.1" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
    <geom name="mountain_collision_left" group="3" type="cylinder" size="150 20" pos="140 130 0.1" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
        <body name="mountain_visual_sub" pos="124 70 -0.9">
            <geom pos="0 0 0" type="mesh" mesh="mountain_mesh" material="mountain_mat" group="0" condim="3" friction="1 0.005 0.0001" quat="0.7071 0.7071 0 0.01" contype="0" conaffinity="0"/>
        </body>
    </body>

    <!-- Flat Terrain scene -->
    <geom pos="13 20 0.01" type="mesh" mesh="flat_terrain_scene_mesh" material="flat_terrain_scene_mat" quat="0.7071 -0.7071 0 0" contype="0" conaffinity="0" group="1"/>

    <!-- Flat Terrain higher detail 1 - under robot -->
    <geom pos="13 20 0.02" type="mesh" mesh="flat_terrain_mesh" material="flat_terrain_mat" quat="0.7071 -0.7071 0 0" contype="0" conaffinity="0" group="1"/>

    <!-- Ground Rocks Under Robot -->
    <geom pos="3 0 0" type="mesh" mesh="ground_rocks_flat_mesh" material="ground_rocks_mat" quat="0.7071 0.7071 0 0" contype="0" conaffinity="0" group="1"/>

    <!-- Ground Rocks around the scene - Big -->
    <geom pos="3 -18 0" type="mesh" mesh="ground_rocks_flat_big_mesh" material="ground_rocks_mat" quat="0.7071 0.7071 0 0" contype="0" conaffinity="0" group="1"/>

    <!-- Ground Rocks around the scene - Big -->
    <geom pos="-10 40 0" type="mesh" mesh="ground_rocks_flat_big_mesh" material="ground_rocks_mat" quat="0.7071 0.7071 0 0" contype="0" conaffinity="0" group="1"/>

    <!-- Ground Rocks Under Truck 1 -->
    <geom pos="13 2 0" type="mesh" mesh="ground_rocks_flat_mesh" material="ground_rocks_mat" quat="0.7071 0.7071 0 0" contype="0" conaffinity="0" group="1"/>

    <!-- Ground Rocks Under Truck 2 -->
    <geom pos="10 18 0" type="mesh" mesh="ground_rocks_flat_mesh" material="ground_rocks_mat" quat="0.7071 0.7071 0 0" contype="0" conaffinity="0" group="1"/>

    <!-- Board Square -->
    <body name="board_square" pos="0 0 0">
        <geom name="board_square_left_collision" group="3" type="cylinder" size="0.01 0.5" pos="0.9 2.3 0.45" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
        <geom name="board_square_right_collision" group="3" type="cylinder" size="0.01 0.5" pos="0.04 2.3 0.45" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
        <body name="board_square_visual_sub" pos="-4 0 0.03" euler="0 0 90">
            <geom type="mesh" mesh="board_square_mesh"  pos="0 -5 -0.3" material="board_square_mat" contype="0" conaffinity="0" group="1" rgba="0.5 0.5 0.5 0.1" quat="0.05 0.05 -0.08 -0.08"/>
        </body>
    </body>

  </worldbody>
</mujoco>