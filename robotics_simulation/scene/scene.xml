<mujoco model="go2w scene">
  <compiler assetdir="assets/models/"/>
  <include file="go2w.xml"/>
  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <visual>
        <!-- This forces MuJoCo's offline/headless cameras to use light calculations -->
        <headlight ambient="0.6 0.6 0.6" diffuse="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
        <global offwidth="1280" offheight="720"/>
    </visual>
  <asset>

  <!-- Main ground --> 
  <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
  <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.67 0.60 0.54" rgb2="0.60 0.53 0.47" markrgb="0.8 0.8 0.8" width="300" height="300"/>
  <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1" roughness="0.6"/>

  <!-- Truck Dumper -->
  <texture name="truck_dumper_tex" type="2d" file="truck_dumper/truck_dumper.png"/>
  <material name="truck_dumper_mat" texture="truck_dumper_tex" roughness="0.5"/>
  <mesh name="truck_dumper_mesh" file="../assets/models/truck_dumper/truck_dumper.obj"/>

  <!-- Rock Brown -->
  <texture name="rock_brown_tex" type="2d" file="rock_brown/rock_brown.png"/>
  <material name="rock_brown_mat" texture="rock_brown_tex" roughness="0.8"/>
  <mesh name="rock_brown_mesh" file="../assets/models/rock_brown/rock_brown.obj"/>

  <!-- Ground Rocks -->
  <texture name="ground_rocks_tex" type="2d" file="ground_rocks/ground_rocks.png"/>
  <material name="ground_rocks_mat" texture="ground_rocks_tex" roughness="0.5"/>
  <mesh name="ground_rocks_high_mesh" file="../assets/models/ground_rocks/ground_rocks.obj"/>

  <!-- Ground Rocks Flat -->
  <mesh name="ground_rocks_flat_mesh" file="../assets/models/ground_rocks/ground_rocks.obj" scale="1 0.125 1"/>

  <!-- Ground Terrain -->
  <texture name="ground_terrain_tex" type="2d" file="ground_terrain/ground_terrain.png"/>
  <material name="ground_terrain_mat" texture="ground_terrain_tex" roughness="0.5"/>
  <mesh name="ground_terrain_mesh" file="../assets/models/ground_terrain/ground_terrain.obj" scale="100 0.001 100" inertia="shell"/>

  <!-- Board Square -->
  <texture name="board_square_tex" type="2d" file="board_square/board_square.png"/>
  <material name="board_square_mat" texture="board_square_tex" roughness="0.5"/>
  <mesh name="board_square_mesh" file="../assets/models/board_square/board_square.obj" scale="0.008 0.008 0.008"/>

  <!-- Cone Warning 
  <texture name="cone_warning_tex" type="2d" file="cone_warning/cone_warning.png"/>
  <material name="cone_warning_mat" texture="cone_warning_tex" roughness="0.5"/>
  <mesh name="cone_warning_mesh" file="../assets/models/cone_warning/cone_warning.obj" scale="0.027 0.027 0.027"/>
-->

  </asset>
  <worldbody>
    <!-- Floor -->
    <geom name="floor_base" type="plane" pos="0 0 0" size="0 0 1" material="groundplane"/>

    <!-- Truck Dumper 1 -->
    <body name="truck_dumper_1" pos="55 24 -0.4" euler="0 0 4.71">
        <body name="truck_visual_sub_1" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="truck_dumper_mesh" material="truck_dumper_mat" contype="0" conaffinity="0" group="1"/>
        </body>
        <body name="collisions_truck_wheels_1" pos="0 0 0">
            <geom name="wheel_front_right_1" type="cylinder" size="1.5 0.65" pos="18.35 -42 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_front_left_1" type="cylinder" size="1.5 0.65" pos="25.5 -42 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_back_right_1" type="cylinder" size="1.5 1.47" pos="24.65 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_back_left_1" type="cylinder" size="1.5 1.47" pos="19.15 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/></body>
        <body name="collisions_truck_ladders_1" pos="0 0 0">
            <geom name="ladder_left_1" type="box" size="0.05 0.25 0.7" pos="24.325 -45.5 1.4" quat="-0.75 0 0.1 0.001" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="ladder_right_1" type="box" size="0.2 0.05 0.65" pos="20.225 -45.83 1.4" quat="0 0 0.5 -0.07" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
        </body>
    </body>


    <!-- Truck Dumper 2 
    <body name="truck_dumper_2" pos="55 50 -0.4" euler="0 0 4.71">
        <body name="truck_visual_sub_2" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="truck_dumper_mesh" material="truck_dumper_mat" contype="0" conaffinity="0" group="1"/>
        </body>
        <body name="collisions_truck_wheels_2" pos="0 0 0">
            <geom name="wheel_front_right_2" type="cylinder" size="1.5 0.65" pos="18.35 -42 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_front_left_2" type="cylinder" size="1.5 0.65" pos="25.5 -42 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_back_right_2" type="cylinder" size="1.5 1.47" pos="24.65 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="wheel_back_left_2" type="cylinder" size="1.5 1.47" pos="19.15 -36 1.8" quat="0.7071 0 0.7071 0" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/></body>
        <body name="collisions_truck_ladders_2" pos="0 0 0">
            <geom name="ladder_left_2" type="box" size="0.05 0.25 0.7" pos="24.325 -45.5 1.4" quat="-0.75 0 0.1 0.001" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
            <geom name="ladder_right_2" type="box" size="0.2 0.05 0.65" pos="20.225 -45.83 1.4" quat="0 0 0.5 -0.07" contype="1" conaffinity="1" rgba="1 0 0 0.4" group="3"/>
        </body>
    </body>
-->

    <!-- Rock Brown under Truck 1 -->
    <body name="rock_brown_1" pos="8 2 0.2">
      <geom name="rock_brown_1_collision" group="3" type="cylinder" size="0.6 0.5" pos="7.2 -0.2 0.1" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
      <body name="rock_brown_1_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
        <geom type="mesh" mesh="rock_brown_mesh" material="rock_brown_mat" contype="0" conaffinity="0" group="2"/>
      </body>
    </body>


    <!-- Rock Brown under Truck 2 
    <body name="rock_brown_2" pos="4 23 0.2"> 
      <geom name="rock_brown_2_collision" group="3" type="cylinder" size="0.6 0.5" pos="7.2 -0.2 0.1" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.5 0.05 0.001" solref="0.001 1" solimp="0.999 0.999 0.001"/>
      <body name="rock_brown_2_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
        <geom type="mesh" mesh="rock_brown_mesh" material="rock_brown_mat" contype="0" conaffinity="0" group="2"/>
      </body>
    </body>
-->

    <!-- Terrain Ground Rocks -->
    <include file="terrain_rocks.xml"/>

    <!-- Board Square -->
    <body name="board_square" pos="-4 0 0.03" euler="0 0 90">
        <geom type="mesh" mesh="board_square_mesh"  pos="0 -5 -0.3" material="board_square_mat" contype="0" conaffinity="0" group="1" rgba="0.5 0.5 0.5 0.1" quat="0.05 0.05 -0.08 -0.08"/>
    </body>

    <!-- Cone Warning 
    <body name="cone_warning" pos="-1 0 0.03">
        <geom name="cone_collision" group="3" type="capsule" size="0.15 0.3" pos="0 0 0.15" rgba="1 0 0 0.4" contype="1" conaffinity="1" friction="1.0 0.005 0.0001" solref="0.002 1" solimp="0.999 0.999 0.001"/>        <body name="cone_warning_visual_sub" pos="0 0 0" quat="0.7071 0.7071 0 0">
            <geom type="mesh" mesh="cone_warning_mesh" material="cone_warning_mat" contype="0" conaffinity="0" group="1"/>
        </body>
    </body>
-->

  </worldbody>
</mujoco>